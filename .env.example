# APPLICATION
ENVIRONMENT=development
DEBUG=true
APP_TITLE=VK Service

# SENTRY
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# POSTGRES
POSTGRES_USER=eqsitecmsvk
POSTGRES_PASSWORD=<set-database-password>
POSTGRES_HOST=eqsitecms-db-vk
POSTGRES_PORT=5432
POSTGRES_DB=eqsitecmsvk

# REDIS
REDIS_PASSWORD=<set-redis-password>

# CELERY SETTINGS
CELERY_APP_MAIN=vk-service
CELERY_APP_BROKER=redis://:<set-redis-password>@eqsitecms-redis:6379/3
CELERY_APP_BACKEND=redis://:<set-redis-password>@eqsitecms-redis:6379/4

# NATS JETSTREAM
NATS_SERVERS=nats://eqsitecms-nats:4222
NATS_STREAM_SITE_EVENTS=SITE_EVENTS
NOTIFICATION_COMMANDS=NOTIFICATION_COMMANDS
NATS_SUBJECTS_NOTIFICATION_COMMANDS=commands.notification.>
# Зарезервировано под будущий VK-канал, подписка не активирована
NATS_SUBJECT_NOTIFICATION_COMMANDS_SEND_VK=commands.notification.vk.send
NATS_CONSUMER_NOTIFICATION_COMMANDS_SEND_VK=vk-service-commands-send-vk
NATS_CONSUMER_ACK_WAIT_SECONDS=30
NATS_CONSUMER_MAX_DELIVER=5
NATS_CONSUMER_FETCH_BATCH_SIZE=10
NATS_CONSUMER_FETCH_TIMEOUT_SECONDS=5

# MAIN BACKEND SERVICE
MAIN_BACKEND_URL=http://eqsitecms-app:8000
MAIN_BACKEND_SERVICE_KEY=<generate-a-random-service-key>

# VK GROUP (заполняет владелец VK-группы перед первым запуском бота)
VK_GROUP_TOKEN=<set-vk-group-access-token>
VK_GROUP_ID=<set-vk-group-numeric-id>
VK_GROUP_SCREEN_NAME=<set-vk-group-screen-name>
VK_API_VERSION=5.199

# VK CONFIRMATION
VK_BOT_LINK_COMMAND=/link
VK_CONFIRMATION_TTL_MINUTES=30
VK_CONFIRMATION_CODE_LENGTH=8
VK_CONFIRMATION_MAX_ATTEMPTS=5
VK_CONFIRMATION_ATTEMPT_WINDOW_MINUTES=10

# VK LONG POLL
VK_LONGPOLL_WAIT_SECONDS=25
